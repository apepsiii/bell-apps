# Configuration for the standalone face recognition service.
# Copy this file to .env and fill in your own values. NEVER commit .env.

# Path to the local SQLite database holding face encodings.
DB_PATH=./faces.db

# Shared secret the Go backend must send in the X-API-Token header.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# When unset, the service refuses every request.
FACE_SERVICE_TOKEN=

# Bind address. Keep this on loopback unless you have a firewall in front.
FACE_SERVICE_HOST=127.0.0.1

# Port the service listens on.
PORT=8001
